{
  "schema_version": 1,
  "operators": [
    {
      "name": "keyed-email-hash",
      "entity": "EMAIL_ADDRESS",
      "action": "hash",
      "text": "alice@example.com",
      "key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "sha256:ab9ad7beed0b75ed6760ab307e6ba6d39a307501933493d0"
    },
    {
      "name": "deterministic-synthetic-email",
      "entity": "EMAIL_ADDRESS",
      "action": "synthetic",
      "text": "alice@example.com",
      "key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "person27437@example.test"
    },
    {
      "name": "generalized-email-domain",
      "entity": "EMAIL_ADDRESS",
      "action": "generalize",
      "text": "alice@example.com",
      "key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "***@example.com"
    },
    {
      "name": "generalized-money-counts-whole-units-only",
      "entity": "MONEY",
      "action": "generalize",
      "text": "Paid $1,284.50 yesterday.",
      "key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "Paid $~10^3 yesterday."
    },
    {
      "name": "generalized-money-decimal-comma",
      "entity": "MONEY",
      "action": "generalize",
      "text": "Rent was €1.284,50, €1 284,50 or 1.284,50 EUR.",
      "key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "Rent was €~10^3, €~10^3 or ~10^3."
    },
    {
      "name": "generalized-money-thousands-groups-and-sub-unit-amounts",
      "entity": "MONEY",
      "action": "generalize",
      "text": "Budget $1,284 or €1.284 or 1,234,567 USD; fees $0.99 or 12,5 GBP.",
      "key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "Budget $~10^3 or €~10^3 or ~10^6; fees $~10^0 or ~10^1."
    }
  ],
  "detection": [
    {
      "name": "unicode-prefix-email-and-card",
      "preset": "finance",
      "text": "Zoë: zoe@example.com / 4111 1111 1111 1111",
      "expected": [
        {"entity": "EMAIL_ADDRESS", "start": 6, "end": 21, "value": "zoe@example.com"},
        {"entity": "CREDIT_CARD", "start": 24, "end": 43, "value": "4111 1111 1111 1111"}
      ]
    },
    {
      "name": "invalid-card-and-routing-are-not-classified-as-those-entities",
      "preset": "strict",
      "text": "4111 1111 1111 1112 then 123456789",
      "expected": [
        {"entity": "PHONE_NUMBER", "start": 0, "end": 14, "value": "4111 1111 1111"},
        {"entity": "US_SSN", "start": 25, "end": 34, "value": "123456789"}
      ]
    },
    {
      "name": "iban-ipv6-and-absolute-url",
      "preset": "strict",
      "text": "DE89370400440532013000 2001:db8::1 https://example.com/a",
      "expected": [
        {"entity": "IBAN_CODE", "start": 0, "end": 22, "value": "DE89370400440532013000"},
        {"entity": "IP_ADDRESS", "start": 23, "end": 34, "value": "2001:db8::1"},
        {"entity": "URL", "start": 35, "end": 56, "value": "https://example.com/a"}
      ]
    },
    {
      "name": "url-userinfo-is-rejected-while-embedded-email-remains-protected",
      "preset": "strict",
      "text": "https://me@example.com/path",
      "expected": [
        {"entity": "EMAIL_ADDRESS", "start": 8, "end": 22, "value": "me@example.com"}
      ]
    },
    {
      "name": "empty-url-userinfo-is-rejected",
      "preset": "strict",
      "text": "https://@example.com/path https://:@example.com/path",
      "expected": []
    },
    {
      "name": "astral-and-variation-selector-prefix",
      "preset": "strict",
      "text": "🛡️ zoe@example.com",
      "expected": [
        {"entity": "EMAIL_ADDRESS", "start": 8, "end": 23, "value": "zoe@example.com"}
      ]
    }
  ],
  "scopes": [
    {
      "name": "scoped-rule-outside-its-scope-leaves-matches-unchanged",
      "scope": "json:/allowed",
      "text": "Contact a@example.com today.",
      "action": "redact",
      "scopes": ["json:/other"],
      "required_detectors": [],
      "allow_terms": [],
      "expected_state": "protected",
      "expected_text": "Contact a@example.com today."
    },
    {
      "name": "scoped-rule-inside-its-scope-applies",
      "scope": "json:/other",
      "text": "Contact a@example.com today.",
      "action": "redact",
      "scopes": ["json:/other"],
      "required_detectors": [],
      "allow_terms": [],
      "expected_state": "protected",
      "expected_text": "Contact [REDACTED:EMAIL_ADDRESS] today."
    },
    {
      "name": "required-detector-blocks-even-when-the-rule-is-scoped-elsewhere",
      "scope": "json:/allowed",
      "text": "Contact a@example.com today.",
      "action": "redact",
      "scopes": ["json:/other"],
      "required_detectors": ["presidio-v1"],
      "allow_terms": [],
      "expected_state": "blocked",
      "expected_text": null,
      "expected_reason": "required detectors unavailable: presidio-v1"
    },
    {
      "name": "allow-term-removes-its-value-in-every-scope",
      "scope": "json:/allowed",
      "text": "safe@example.com",
      "action": "redact",
      "scopes": ["json:/other"],
      "required_detectors": [],
      "allow_terms": ["safe@example.com"],
      "expected_state": "protected",
      "expected_text": "safe@example.com"
    }
  ]
}
